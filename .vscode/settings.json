  "files.associations": {
    "*.js": "javascript"
  },
  "javascript.suggest.completeFunctionCalls": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "editor.wordWrap": "on",
  "files.exclude": {
    "**/.DS_Store": true,
    "node_modules": true
  }
}
